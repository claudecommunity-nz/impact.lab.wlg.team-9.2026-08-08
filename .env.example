# Copy to .env and adjust. docker compose reads .env automatically.
# Everything here has a working default — .env is optional.

# --- ports on your machine ---
UI_PORT=8080
API_PORT=8000
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081

# --- storage ---
MONGO_DB=signals

# --- how often each scraper polls (seconds) ---
RSS_INTERVAL=600
GEONET_INTERVAL=300
MASTODON_INTERVAL=300
# Undocumented public-map backends — poll no faster than 120s
WELECTRICITY_INTERVAL=120
NZTA_INTERVAL=120

# --- enrichment schedule: job:interval_seconds, comma separated ---
ENRICHMENT_SCHEDULE=classify:30,geolocate:30,corroborate:60,admiralty:60

# --- corroboration tuning: how close in space and time before two signals
#     are treated as possibly describing the same event ---
CLUSTER_RADIUS_KM=2.0
CLUSTER_WINDOW_HOURS=12

# --- logging ---
LOG_LEVEL=INFO

# --- synthetic Reddit corpus ---
# The key lives in Azure Key Vault, not here. Pull it into your shell instead
# of pasting it into a file:
#   export REDDIT_API_KEY="$(az keyvault secret show \
#     --vault-name team9-kv-f76f44cb --name reddit-api-key --query value -o tsv)"
# REDDIT_API_KEY=
REDDIT_INTERVAL=300

# The corpus is historical. These two anchors define the offset applied to the
# clock: real SIM_REAL_ANCHOR is treated as corpus SIM_ANCHOR, and simulated
# time then advances at real-time speed. 110 days apart as set below.
SIM_ANCHOR=2026-04-20T00:00:00Z
SIM_REAL_ANCHOR=2026-08-08T00:00:00Z

# --- optional scraper overrides ---
# RSS_FEEDS=Name|https://example.com/feed.xml;Other|https://example.org/rss
# MASTODON_INSTANCE=mastodon.nz
# MASTODON_TAGS=wellington,wgtn,nzwx
